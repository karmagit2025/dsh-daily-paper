{
  "name": "dsh-daily-paper",
  "version": "0.3.0",
  "type": "module",
  "description": "UP 日报：每天一份的私人日报（B站 + 即刻），杂志版式、按信源分栏、同页配置，自带采集脚本。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "scripts",
    "examples",
    "README.md",
    "LICENSE",
    "SETUP.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "license": "MIT",
  "author": "骆晓阳",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karmagit2025/dsh-daily-paper.git"
  },
  "homepage": "https://github.com/karmagit2025/dsh-daily-paper",
  "bugs": {
    "url": "https://github.com/karmagit2025/dsh-daily-paper/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "daily",
    "rss",
    "bilibili",
    "jike"
  ]
}
